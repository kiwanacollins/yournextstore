# Dev-mode Dockerfile, matching how the sibling medusa/ service runs locally —
# `next dev`, not a production build. Payload's own generated Dockerfile builds a
# standalone production image (requires `output: "standalone"` in next.config.ts,
# which isn't set) and is left as-is for a future production deploy pass.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

COPY . .

EXPOSE 3002

CMD ["npx", "next", "dev", "-p", "3002"]
