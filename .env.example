# Medusa backend (self-hosted — see docker-compose.yml)
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here

# Payload CMS (self-hosted — see docker-compose.yml): blog, legal pages, reviews,
# newsletter, contact
PAYLOAD_URL=http://localhost:3002

# Store metadata (no more hosted "store settings" record — plain env config)
NEXT_PUBLIC_STORE_NAME="Mutindo Express Cakes Kampala"
NEXT_PUBLIC_STORE_DESCRIPTION="Professional custom bakery in Kampala, Uganda. Fresh, custom-made cakes for birthdays, weddings, graduations, baby showers, and corporate events — with reliable delivery across Kampala and beyond."
NEXT_PUBLIC_STORE_CURRENCY=UGX
NEXT_PUBLIC_STORE_LOCALE=en-UG

# Canonical URL for metadata/sitemaps
NEXT_PUBLIC_URL=http://localhost:3000
